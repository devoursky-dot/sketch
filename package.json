{
  "name": "rotosketch-studio",
  "version": "1.0.0",
  "description": "스케치북 Pro 역추적 분석 기반 동영상 로토스코핑 & 2D 애니메이션 제작 스튜디오",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
